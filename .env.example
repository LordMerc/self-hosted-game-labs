# Port the panel listens on (host networking, so this is a host port)
PANEL_PORT=8090
# Optional. If empty, a secret is generated once and stored in the data directory.
# SESSION_SECRET=
# LAN IP of this machine (give it an address reservation in your router)
# Optional: detected automatically. Set it if the panel guesses the wrong address.
# HOST_LAN_IP=192.168.1.50
# Where game servers and their world data are stored on the host. Default /srv/gameservers.
# Point it at another drive (it must already be mounted) to keep game data off your system disk.
# GAME_DATA_DIR=/mnt/games
# Hostname players use to reach this machine, e.g. play.example.com
PUBLIC_HOST=
# manual | upnp
CONNECTIVITY=manual
# Cloudflare DDNS (optional until Milestone 1 DNS work lands). Token needs Zone:DNS:Edit only.
CF_API_TOKEN=
CF_ZONE=
