# Port the panel listens on (host networking, so this is a host port)
PANEL_PORT=8090
# Optional. If empty, a secret is generated once and stored in the data directory.
# SESSION_SECRET=
# LAN IP of this machine (give it an address reservation in your router)
# Optional: detected automatically. Set it if the panel guesses the wrong address.
# HOST_LAN_IP=192.168.1.50
# Where game servers and their world data are stored on the host. Default /srv/gameservers.
# Point it at another drive (it must already be mounted) to keep game data off your system disk.
# GAME_DATA_DIR=/mnt/games
# Only for a second copy of the panel next to the real one (for example a beta). Give it its own name, port and game
# data folder, so the two never touch each other's game servers, router rules or DNS records. Leave unset otherwise.
# INSTANCE=beta
# How ports are opened on your router: manual (the panel shows the rules to add) or upnp (automatic)
CONNECTIVITY=manual
# Cloudflare DNS is easiest to set up on the panel's Settings page (no variables needed).
# Setting these instead overrides the Settings page. The token needs Zone > Zone > Read and Zone > DNS > Edit,
# limited to your domain.
# PUBLIC_HOST=play.example.com
# CF_API_TOKEN=
# CF_ZONE=example.com

# How many backups to keep per server (default 7). A backup is never removed before it is 7 days old,
# and deleting a server never deletes its backups.
# BACKUP_KEEP=7

# The Network panel's "External port check" sends your public IP and a port number to check-host.net, but only when you
# press Run. Set to off to remove the button.
# PORT_CHECK=on

# Only if you put the panel behind a reverse proxy or tunnel (Caddy, Nginx, cloudflared, ...); see docs/exposing-the-panel.md.
# TRUST_PROXY is the address the proxy connects from (for example 127.0.0.1, or a Docker network such as 172.18.0.0/16). It makes
# the sign-in lockout and the Secure cookie use the real visitor and the real HTTPS status. Leave empty when people reach the panel directly.
# TRUST_PROXY=127.0.0.1
# PANEL_HOST=127.0.0.1 makes the panel answer only on this machine, so a proxy running on it is the only way in.
# The session cookie is marked Secure when a visit came in over HTTPS (auto). "always" forces it, "never" turns it off.
# COOKIE_SECURE=auto

# Once a day the panel asks GitHub whether a newer release exists, and shows a notice if so. It never updates itself.
# Set to off to stop the checks (it can also be switched off on the Settings page).
# UPDATE_CHECK=on
