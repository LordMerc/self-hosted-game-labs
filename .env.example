# Port the panel listens on (host networking, so this is a host port)
PANEL_PORT=8090
# Optional. If empty, a secret is generated once and stored in the data directory.
# SESSION_SECRET=
# LAN IP of this machine (give it an address reservation in your router)
# Optional: detected automatically. Set it if the panel guesses the wrong address.
# HOST_LAN_IP=192.168.1.50
# Where game servers and their world data are stored on the host. Default /srv/gameservers.
# Point it at another drive (it must already be mounted) to keep game data off your system disk.
# GAME_DATA_DIR=/mnt/games
# How ports are opened on your router: manual (the panel shows the rules to add) or upnp (automatic)
CONNECTIVITY=manual
# Cloudflare DNS is easiest to set up on the panel's Settings page (no variables needed).
# Setting these instead overrides the Settings page. The token needs Zone > Zone > Read and Zone > DNS > Edit,
# limited to your domain.
# PUBLIC_HOST=play.example.com
# CF_API_TOKEN=
# CF_ZONE=example.com

# How many backups to keep per server (default 7). A backup is never removed before it is 7 days old,
# and deleting a server never deletes its backups.
# BACKUP_KEEP=7

# The Network panel's "External port check" sends your public IP and a port number to check-host.net, but only when you
# press Run. Set to off to remove the button.
# PORT_CHECK=on
